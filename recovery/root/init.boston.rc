# Motorola Moto G Stylus 2024 (boston) Device-Specific Initialization

on fs
    mkdir /metadata 0755 root root
    
on boot
    setprop ro.product.device boston
    setprop ro.product.model "Moto G Stylus 2024"
    setprop ro.product.board boston
    
    write /sys/class/android_usb/android0/idVendor 22b8
    write /sys/class/android_usb/android0/idProduct 2e82
